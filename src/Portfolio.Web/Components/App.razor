<!DOCTYPE html>
<html lang="@ContentService.HtmlLang(lang)" data-theme="dark" data-logo="@Site.Value.Logo" data-palette="@Site.Value.Palette" data-default-logo="@Site.Value.Logo" data-default-palette="@Site.Value.Palette" data-brand-lab="@(Features.Value.BrandLab ? "on" : null)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B0F12" />
    <BasePath />
    @* Aplica as escolhas salvas antes de pintar a página (evita "piscar" ao carregar).
       Paleta e logo salvos só valem com o laboratório /brand ligado; em produção vale o appsettings. *@
    <script>
        (function () { try { var d = document.documentElement; var keys = d.hasAttribute("data-brand-lab") ? ["theme", "palette", "logo"] : ["theme"]; keys.forEach(function (k) { var v = localStorage.getItem(k); if (v) d.setAttribute("data-" + k, v); }); } catch (e) { } })();
    </script>
    <ResourcePreloader />
    @foreach (var alt in ContentService.Languages)
    {
        <link rel="alternate" hreflang="@ContentService.HtmlLang(alt)" href="@($"{baseUrl}{ContentService.SwitchLanguagePath(path, alt)}")" />
    }
    @* Para quem não fala nenhum dos idiomas: a raiz escolhe pelo idioma do navegador. *@
    <link rel="alternate" hreflang="x-default" href="@($"{baseUrl}/")" />
    <link rel="canonical" href="@($"{baseUrl}{path}")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Instrument+Serif:ital@1&family=JetBrains+Mono:wght@400;500;700&family=Unbounded:wght@800&family=Sora:wght@700&family=Syne:wght@800&family=Bricolage+Grotesque:wght@400;800&display=swap" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Portfolio.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/site.js"]"></script>
</body>

</html>

@code {
    [Inject] private IOptions<SiteOptions> Site { get; set; } = default!;
    [Inject] private IOptions<FeatureOptions> Features { get; set; } = default!;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string path = "/";
    private string lang = ContentService.DefaultLanguage;
    private string baseUrl = "";

    protected override void OnInitialized()
    {
        path = HttpContext?.Request.Path.Value ?? "/";
        lang = ContentService.LanguageFromPath(path);
        if (HttpContext is not null)
            baseUrl = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}";
    }
}
