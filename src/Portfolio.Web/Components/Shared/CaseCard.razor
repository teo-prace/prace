<article class="case-card">
    <header class="case-head">
        <span class="mono-label">@Item.Client</span>
        <h3>@Item.Title</h3>
    </header>
    <dl class="case-rows">
        @* Aceitam **negrito** (Rich): use só no que o cliente procura ao passar os olhos. *@
        <div><dt>@Labels.Context</dt><dd>@Rich.Render(Item.Context)</dd></div>
        <div><dt>@Labels.Challenge</dt><dd>@Rich.Render(Item.Challenge)</dd></div>
        <div><dt>@Labels.Solution</dt><dd>@Rich.Render(Item.Solution)</dd></div>
        <div><dt>@Labels.Result</dt><dd>@Rich.Render(Item.Result)</dd></div>
    </dl>
    @if (Item.Tags.Count > 0)
    {
        <ul class="chips">
            @foreach (var tag in Item.Tags)
            {
                <li>@tag</li>
            }
        </ul>
    }
    @if (!string.IsNullOrEmpty(Item.Link) && !string.IsNullOrEmpty(Item.LinkText))
    {
        <p class="case-link"><a class="btn btn-ghost" href="@Item.Link">@Item.LinkText →</a></p>
    }
</article>

@code {
    [Parameter, EditorRequired] public CaseItem Item { get; set; } = default!;
    [Parameter, EditorRequired] public CaseLabels Labels { get; set; } = default!;
}
