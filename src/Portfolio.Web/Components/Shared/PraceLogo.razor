@*
    Logos da marca (spec: PRACE-logo-spec.md). Só as cores mudam, sempre pelos tokens --prace-*,
    que cada área do site define (escura/clara) a partir da paleta ativa. Não mexer na geometria.

    Variantes:
      dot        texto + pontinho (logo provisório anterior)
      horizontal 4m/4n: paralelogramo com "P" + PRACE + subtítulo   (header, assinatura, LinkedIn)
      compact    4m/4n sem subtítulo                                (header em tamanho pequeno)
      bridge     12: PRACE + arco de ponte                          (wordmark)
      syne       8: "prace" minúsculo                               (wordmark minimalista)
      stacked    11: bloco PRA/CE                                   (avatar, ícone quadrado)
*@

@switch (Variant)
{
    case "horizontal":
        <svg class="prace-logo @Class" data-v="horizontal" viewBox="36 24 368 76" role="img" aria-label="PRACE — @Subtitle">
            <polygon points="50,30 92,30 84,90 42,90" fill="var(--prace-primary)" />
            <text x="67" y="76" text-anchor="middle" font-family="Bricolage Grotesque" font-weight="800" font-size="40" font-style="italic" fill="var(--prace-on-primary)">P</text>
            <text x="108" y="74" font-family="Bricolage Grotesque" font-weight="800" font-size="44" font-style="italic" fill="var(--prace-text)">PRACE</text>
            <text x="110" y="94" font-family="Bricolage Grotesque" font-weight="400" font-size="12" letter-spacing="@(Subtitle.Length > 32 ? "1" : "2")" fill="var(--prace-muted)">@Subtitle</text>
        </svg>
        break;

    case "compact":
        <svg class="prace-logo @Class" data-v="compact" viewBox="38 26 232 68" role="img" aria-label="PRACE">
            <polygon points="50,30 92,30 84,90 42,90" fill="var(--prace-primary)" />
            <text x="67" y="76" text-anchor="middle" font-family="Bricolage Grotesque" font-weight="800" font-size="40" font-style="italic" fill="var(--prace-on-primary)">P</text>
            <text x="108" y="76" font-family="Bricolage Grotesque" font-weight="800" font-size="44" font-style="italic" fill="var(--prace-text)">PRACE</text>
        </svg>
        break;

    case "bridge":
        <svg class="prace-logo @Class" data-v="bridge" viewBox="30 30 140 72" role="img" aria-label="PRACE">
            <text x="100" y="62" text-anchor="middle" font-family="Sora" font-weight="700" font-size="34" letter-spacing="3" fill="var(--prace-text)">PRACE</text>
            <path d="M40 86 Q100 66 160 86" fill="none" stroke="var(--prace-primary)" stroke-width="4" />
            <line x1="40" y1="86" x2="40" y2="96" stroke="var(--prace-primary)" stroke-width="4" />
            <line x1="160" y1="86" x2="160" y2="96" stroke="var(--prace-primary)" stroke-width="4" />
        </svg>
        break;

    case "syne":
        @* Ajuste em relação à spec: com a Syne 800 real, letter-spacing -4 encavalava as letras
           e o texto saía do viewBox (55 36 130 52). Espaçamento -1.5 e viewBox alargado. *@
        <svg class="prace-logo @Class" data-v="syne" viewBox="8 36 224 52" role="img" aria-label="prace">
            <text x="120" y="76" text-anchor="middle" font-family="Syne" font-weight="800" font-size="48" letter-spacing="-1.5" fill="var(--prace-primary)">prace</text>
        </svg>
        break;

    case "stacked":
        <svg class="prace-logo @Class" data-v="stacked" viewBox="65 15 70 90" role="img" aria-label="PRACE">
            <rect x="65" y="15" width="70" height="90" fill="var(--prace-primary)" />
            <text x="100" y="55" text-anchor="middle" font-family="Unbounded" font-weight="800" font-size="24" fill="var(--prace-on-primary)">PRA</text>
            <text x="100" y="88" text-anchor="middle" font-family="Unbounded" font-weight="800" font-size="24" fill="var(--prace-on-primary)">CE</text>
        </svg>
        break;

    default:
        <span class="logo-text @Class" data-v="dot"><span class="logo-dot" aria-hidden="true"></span>Prace</span>
        break;
}

@code {
    public static readonly string[] Variants = ["dot", "horizontal", "compact", "bridge", "syne", "stacked"];

    [Parameter] public string Variant { get; set; } = "compact";
    [Parameter] public string Subtitle { get; set; } = "TEO PRACE · LEGACY MODERNIZATION";
    [Parameter] public string? Class { get; set; }
}
